PORT=3001
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/toxiclean
# Public URL of the webapp, used in emailed links.
WEBAPP_URL=http://localhost:4000
# Addresses allowed to set X-Forwarded-For (the webapp). See Express "trust proxy".
# loopback when both run on one machine; uniquelocal in Docker/Coolify.
TRUST_PROXY=loopback
# Where uploaded files (booking photos) are stored.
UPLOADS_DIR=uploads

# --- Email (Brevo) ---
# Without BREVO_API_KEY, emails are logged to the console instead of sent.
# The sender address must be a verified sender/domain in Brevo.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Toxiclean
# Inbox notified about new requests, bookings and contact messages (optional).
MAIL_TEAM_EMAIL=

# --- File storage (S3) ---
# Leave S3_BUCKET empty to store uploads on local disk under UPLOADS_DIR.
S3_BUCKET=
S3_REGION=eu-west-1
# Optional: omit to use the server's IAM role / default AWS credentials.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional key prefix inside the bucket, e.g. production.
S3_PREFIX=
# Only for S3-compatible services (Cloudflare R2, DigitalOcean Spaces, MinIO).
S3_ENDPOINT=

# --- Owner account ---
# On startup, if no super admin exists yet, this email becomes one: an existing account
# is promoted, otherwise it's created with SUPER_ADMIN_PASSWORD (min. 8 characters, an
# uppercase letter and a number). Leave the password empty to be emailed a set-password
# link instead. Ignored once a super admin exists.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# --- Purchase requests ---
# Accounts payments can be received into, per country, separated by "|".
# Shown in the admin's Record Payment form.
PAYMENT_ACCOUNTS_NG=GTBank, Nigeria|Cash (Lagos office)
PAYMENT_ACCOUNTS_BJ=
